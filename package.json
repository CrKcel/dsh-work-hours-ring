{
  "name": "@local/dsh-work-hours-ring",
  "version": "1.0.0",
  "private": true,
  "description": "Work-hours ring beside the composer's model selector",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/artifact.test.js && node test/worktime.test.js && node test/client.test.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrKcel/dsh-work-hours-ring.git"
  },
  "devDependencies": {
    "chinese-days": "^1.5.9"
  }
}
