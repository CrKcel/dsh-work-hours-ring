{
  "name": "@local/dsh-work-hours-ring",
  "version": "1.0.0",
  "private": true,
  "description": "Work-hours ring beside the composer's model selector",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.source.js",
    "build.mjs",
    "worktime.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test/worktime.test.js && node test/client.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
